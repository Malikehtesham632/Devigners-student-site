# Devigners Learning Institute — Environment Configuration Template
# Copy this file to .env and fill in your real credentials.

# -------------------------------------------------------------
# 1. Email Notification Settings (Gmail SMTP)
# -------------------------------------------------------------
# The Gmail address used to send out student confirmations and alerts
SENDER_EMAIL=your-institute-gmail@gmail.com

# 16-character App Password generated from your Google Account:
# Go to https://myaccount.google.com/security -> 2-Step Verification -> App Passwords
SENDER_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# The admin / HR email address that will receive new student applications
NOTIFY_EMAIL=your-admin-email@gmail.com

# Optional SMTP overrides (defaults to Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# -------------------------------------------------------------
# 2. Google Sheets Integration (Optional Webhook)
# -------------------------------------------------------------
# Deployed Google Apps Script /exec URL (Optional)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Secret key matching WEBHOOK_SECRET in Code.gs
GOOGLE_SHEETS_WEBHOOK_SECRET=your-secure-webhook-secret

# -------------------------------------------------------------
# 3. Frontend & API URLs
# -------------------------------------------------------------
VITE_API_BASE_URL=https://devignersstudentsite.vercel.app/